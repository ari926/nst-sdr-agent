# ── Required ──────────────────────────────────────────────────────────────────
# Perplexity Sonar key — used for /research, /enrich, /call-prep, and Sonar-based
# enrichment on /sf-enrich-account when Apollo is not configured.
# Get yours at https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-your-key-here

# ── Optional ──────────────────────────────────────────────────────────────────
PORT=3000
SONAR_MODEL=sonar-pro

# Roam webhook URL for SDR Draft assignment notifications
# When set, POST /create-sdr-draft will send a message to the assigned rep via Roam.
# Leave blank to disable notifications (drafts will still be created normally).
ROAM_WEBHOOK_URL=

# ── Salesforce (required for /sf-enrich-account and /sf-bulk-enrich) ─────────
# Connected App OAuth, Username-Password flow. Setup:
#   1. Setup → App Manager → New Connected App
#   2. Enable OAuth Settings, Callback URL = https://login.salesforce.com (placeholder)
#   3. Selected OAuth Scopes: "Full access (full)" and "Perform requests at any time (refresh_token, offline_access)"
#   4. Save → after 2-10 min, copy Consumer Key/Secret into the vars below
#   5. Use an integration user (License: Salesforce, Profile: API Only or System Admin)
#   6. Reset that user's security token: Setup → Personal → Reset My Security Token
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_LOGIN_URL=https://login.salesforce.com
SF_API_VERSION=v60.0

# ── Apollo.io (optional — if set, takes priority over Sonar for enrichment) ──
# Apollo Basic is $49/mo. If APOLLO_API_KEY is unset, the agent falls back to
# Sonar-based enrichment automatically. No code change required.
# Get yours at https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=
